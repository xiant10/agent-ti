{
  "port": "${PORT:-18120}",
  "instanceId": "${AGENT_INSTANCE_ID:-agent-ti-0}",
  "logLevel": "${LOG_LEVEL:-info}",
  "storage": { "kind": "sqlite", "dir": "${AGENT_DATA_DIR:-/data}" },
  "auth": {
    "algorithms": "RS256,ES256",
    "jwksUrl": "${JWT_JWKS_URL:-http://auth-server.t10.svc.cluster.local:18000/.well-known/jwks.json}",
    "issuer": "${JWT_ISSUER:-http://localhost:18000}",
    "audience": "${JWT_AUDIENCE:-t10}",
    "requiredScopes": "${JWT_REQUIRED_SCOPES:-agent:use}",
    "userClaim": "sub",
    "tenantClaim": "tid"
  },
  "limits": {
    "maxBodyBytes": "${MAX_BODY_BYTES:-1000000}",
    "maxConcurrentRuns": "${MAX_RUNS:-200}",
    "maxConcurrentRunsPerTenant": "${MAX_RUNS_PER_TENANT:-16}",
    "maxStreams": 1000
  },
  "agents": "${AGENT_CONFIG:-/etc/agent-ti/agents/ti/agent.json}",
  "defaultAgent": "ti"
}
