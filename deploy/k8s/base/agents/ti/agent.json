{
  "agent": "ti",
  "bundle": "${AGENT_BUNDLE:-}",
  "models": {
    "chat": {
      "provider": "openai-compatible",
      "providerId": "gateway",
      "modelId": "${CHAT_MODEL_ID:-qwen3.5-flash}",
      "baseUrl": "${LLM_BASE_URL:-http://ai-gateway-llm.t10.svc.cluster.local:18080/v1}",
      "apiKeyEnv": "LLM_API_KEY",
      "contextWindow": 128000,
      "maxOutputTokens": 2048,
      "identityHeaders": "gateway"
    }
  },
  "defaultProfile": "chat",
  "profiles": {
    "chat": {
      "model": "chat",
      "thinkingLevel": "off",
      "maxActiveTools": 40,
      "alwaysOnTools": ["*"],
      "preload": { "maxTools": 8, "minScore": 3 }
    },
    "voice": {
      "model": "chat",
      "thinkingLevel": "off",
      "maxActiveTools": 24,
      "alwaysOnTools": ["*"],
      "instructionsFile": "voice.md",
      "speech": true
    }
  },
  "instructions": [{ "name": "base", "file": "base.md", "tag": false }],
  "grants": {
    "url": "${AUTH_URL:-http://auth-server.t10.svc.cluster.local:18000}",
    "clientId": "${AGENT_GRANTS_CLIENT_ID:-agent-ti}",
    "clientSecret": "${AUTH_CLIENT_SECRET:-}",
    "actions": "${GRANT_ACTIONS:-agent:use}",
    "audiences": "${GRANT_AUDIENCES:-agent-ti,ai-gateway-tools}"
  },
  "tenantSkills": {
    "url": "${AGENT_CONTROL_URL:-http://t10-agent-control.t10.svc.cluster.local:18010}"
  },
  "tenantConnectors": {
    "gatewayUrl": "${TOOL_GATEWAY_URL:-http://ai-gateway-tools.t10.svc.cluster.local:18095}"
  },
  "limits": { "maxSessionsPerUser": 1000, "maxConcurrentRunsPerUser": 20, "maxToolRounds": 12 },
  "durable": { "stream": { "timeoutMs": 120000 } }
}
