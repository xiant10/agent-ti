{
  "name": "ti",
  "agent": {
    "title": "Ti Assistant",
    "default_profile": "chat",
    "tenants": ["ten_acme", "ten_sample-acme", "ten_sample-globex"],
    "routes": [{"pool": "ti"}]
  },
  "pool": {
    "agent": "ti",
    "state": "active",
    "harness": "ti",
    "audience": "agent-ti",
    "capabilities": ["durable_runs"],
    "replicas": {
      "agent-ti-0": "http://agent-ti-0.agent-ti.t10.svc.cluster.local:18120"
    }
  }
}
